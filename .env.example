# ==================== LLM 配置 (DeepSeek) ====================
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_TEMPERATURE="0.3"
DEEPSEEK_MAX_TOKENS="1024"

# ==================== 前端与服务端口 ====================
FRONTEND_PORT="3000"
FASTAPI_PORT="8000"

# ==================== Ollama 向量模型 (BGE-M3) ====================
# 留空/注释时自动适配：本地 python3 app.py 默认连 http://localhost:11434；Docker 默认连 http://host.docker.internal:11434
# 若使用 `docker compose --profile ollama up -d`，请取消注释并改为 "http://ollama:11434"
# OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_EMBED_MODEL="bge-m3"
EMBEDDING_DIM="1024"

# ==================== PostgreSQL 16 ====================
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="intelliserve"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/intelliserve"
DB_ECHO="false"
DB_POOL_SIZE="10"
DB_MAX_OVERFLOW="20"

# ==================== Redis 7.2.3 分布式会话锁 ====================
REDIS_PORT="6379"
REDIS_URL="redis://localhost:6379/0"
SESSION_LOCK_TIMEOUT_SECONDS="5.0"
SESSION_LOCK_TTL_SECONDS="90.0"

# ==================== Qdrant 向量数据库 ====================
# 留空/注释时自动适配：本地 python3 app.py 默认走纯内存 (:memory:)；Docker 默认连 qdrant:6333
# 若本地调试也想连 Docker 启动的 Qdrant，可取消注释并设为 "localhost"
# QDRANT_HOST="localhost"
QDRANT_PORT="6333"
QDRANT_COLLECTION="xx_mall_faq"
QDRANT_API_KEY=""

# ==================== AI Studio 预览环境保留变量 ====================
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
