# ==================== LLM 配置 (DeepSeek) ====================
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_TEMPERATURE="0.3"
DEEPSEEK_MAX_TOKENS="1024"

# ==================== 前端与服务端口 ====================
FRONTEND_PORT="3000"
FASTAPI_PORT="8000"

# ==================== Ollama 向量模型 (BGE-M3) ====================
# 本地直接运行 FastAPI 时填 http://localhost:11434；
# 使用 docker compose 启动且 Ollama 跑在宿主机时可留空或填 http://host.docker.internal:11434；
# 若启用 `docker compose --profile ollama up -d`，可改为 http://ollama:11434
OLLAMA_BASE_URL="http://host.docker.internal:11434"
OLLAMA_EMBED_MODEL="bge-m3"
EMBEDDING_DIM="1024"

# ==================== PostgreSQL 16 ====================
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="intelliserve"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/intelliserve"
DB_ECHO="false"
DB_POOL_SIZE="10"
DB_MAX_OVERFLOW="20"

# ==================== Redis 7.2.3 分布式会话锁 ====================
REDIS_PORT="6379"
REDIS_URL="redis://localhost:6379/0"
SESSION_LOCK_TIMEOUT_SECONDS="5.0"
SESSION_LOCK_TTL_SECONDS="90.0"

# ==================== Qdrant 向量数据库 ====================
QDRANT_HOST="qdrant"
QDRANT_PORT="6333"
QDRANT_COLLECTION="xx_mall_faq"
QDRANT_API_KEY=""

# ==================== AI Studio 预览环境保留变量 ====================
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
